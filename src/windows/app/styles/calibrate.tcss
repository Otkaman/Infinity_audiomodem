.calibrate-container {
    width: 90%;
    height: 80%;
    margin: 1 2;
}

.role-buttons {
    align: center middle;
    margin: 1 0;
}

.freq-grid {
    grid-size: 4 2;
    grid-gutter: 1 2;
    margin: 1 2;
}

.freq-label {
    width: 22;
    text-style: bold;
}

.good {
    color: #6a9955;
}

.weak {
    color: #ce9178;
}

.noisy {
    color: #dcdcaa;
}
